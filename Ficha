<!DOCTYPE html><html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ficha RPG Premium</title><style>
body {
  margin: 0;
  background: #2a1b0c;
  font-family: 'Georgia', serif;
}

.container {
  max-width: 850px;
  margin: 20px auto;
  background: linear-gradient(#f3e2b8, #e6cc8f);
  border: 10px solid #6b4b1f;
  border-radius: 14px;
  padding: 25px;
  box-shadow: 0 0 25px rgba(0,0,0,0.6);
}

.header {
  text-align: center;
}

.badge {
  display: inline-block;
  padding: 5px 15px;
  border: 1px solid #a07a3a;
  border-radius: 8px;
  font-size: 12px;
  letter-spacing: 2px;
  margin-bottom: 10px;
}

h1 {
  margin: 5px 0;
  font-size: 32px;
}

.subtitle {
  font-style: italic;
  color: #5a4a2a;
}

.divider {
  border-bottom: 2px solid #b89b5e;
  margin: 15px 0;
}

.stats {
  display: flex;
  gap: 15px;
}

.card {
  flex: 1;
  background: #f5e6c5;
  border-radius: 10px;
  padding: 15px;
  text-align: center;
}

.card strong {
  font-size: 24px;
  display: block;
}

button {
  margin: 5px;
  padding: 5px 10px;
  border: none;
  background: #6b4b1f;
  color: white;
  border-radius: 6px;
}

.section {
  margin-top: 20px;
}

.section h3 {
  letter-spacing: 2px;
  font-size: 14px;
  border-bottom: 1px solid #b89b5e;
}

.attr {
  display: flex;
  justify-content: space-between;
  margin: 8px 0;
  align-items: center;
}

.dots {
  display: flex;
  gap: 4px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #c9a74d;
  opacity: 0.3;
}

.dot.active {
  opacity: 1;
}

input[type="number"] {
  width: 50px;
}

textarea {
  width: 100%;
  background: #f5e6c5;
  border: none;
  padding: 10px;
  border-radius: 8px;
}

.tag {
  display: inline-block;
  padding: 5px 10px;
  background: #d8c08a;
  border-radius: 10px;
  margin: 4px;
}

</style></head><body>
<div class="container"><div class="header">
  <div class="badge" contenteditable="true">GUERREIRO • HUMANO</div>
  <h1 contenteditable="true">Aldric Ferrocut</h1>
  <div class="subtitle" contenteditable="true">34 anos — Ex-soldado da Guarda Real</div>
</div><div class="divider"></div><div class="stats">
  <div class="card">
    VIDA
    <strong id="vida">18</strong>
    <button onclick="mudarVida(-1)">-</button>
    <button onclick="mudarVida(1)">+</button>
  </div>  <div class="card">
    DEFESA
    <strong contenteditable="true">2d6</strong>
    <div>Força 2</div>
  </div>
</div><div class="section">
<h3>ATRIBUTOS</h3><div class="attr">Força <div class="dots" data-value="2"></div> <input type="number" value="2" onchange="updateDots(this)"></div>
<div class="attr">Inteligência <div class="dots" data-value="1"></div> <input type="number" value="1" onchange="updateDots(this)"></div>
<div class="attr">Agilidade <div class="dots" data-value="3"></div> <input type="number" value="3" onchange="updateDots(this)"></div>
<div class="attr">Carisma <div class="dots" data-value="4"></div> <input type="number" value="4" onchange="updateDots(this)"></div></div><div class="section">
<h3>INVENTÁRIO</h3>
<textarea>Espada longa, escudo de ferro, armadura de placas, cantil, rações</textarea>
</div><div class="section">
<h3>PERÍCIAS</h3>
<textarea>Combate corpo a corpo, Intimidação, Resistência física</textarea>
</div><div class="section">
<h3>HISTÓRIA</h3>
<textarea>Aldric foi soldado da guarda real por dez anos até ver seu capitão trair o reino...</textarea>
</div><div class="section">
<h3>PALAVRAS-CHAVE</h3>
<div id="tags">
<span class="tag">Honra</span>
<span class="tag">Redenção</span>
<span class="tag">Lealdade</span>
</div>
<input id="nova" placeholder="Nova palavra">
<button onclick="addTag()">Adicionar</button>
</div></div><script>
function mudarVida(v){
  let el = document.getElementById('vida');
  el.innerText = parseInt(el.innerText) + v;
}

function updateDots(input){
  let value = input.value;
  let dotsDiv = input.previousElementSibling;
  dotsDiv.innerHTML = '';

  for(let i=0;i<5;i++){
    let d = document.createElement('div');
    d.className = 'dot' + (i < value ? ' active' : '');
    dotsDiv.appendChild(d);
  }
}

function addTag(){
  let input = document.getElementById('nova');
  if(input.value.trim() !== ''){
    let span = document.createElement('span');
    span.className = 'tag';
    span.innerText = input.value;
    document.getElementById('tags').appendChild(span);
    input.value = '';
  }
}

// inicializar dots
document.querySelectorAll('.attr input').forEach(updateDots);
</script></body>
</html>
